# Database
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=jobseeker_db
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/jobseeker_db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email Configuration (for job alerts ingestion)
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# SMTP Configuration (for sending notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=jobseeker-data

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Demo Mode (optional - for testing)
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
TEST_PASSWORD=

# Job Processing
MAX_JOBS_PER_DIGEST=10
JOB_SCORE_THRESHOLD=70
PROPOSAL_MAX_LENGTH=200

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# Monitoring
SENTRY_DSN=your_sentry_dsn_here
PROMETHEUS_PORT=9090

# =============================================================================
# JOB SOURCE API KEYS (Optional - enables additional job sources)
# =============================================================================

# Adzuna - Job aggregator covering 16+ countries (250 free calls/day)
# Sign up at: https://developer.adzuna.com/
# ADZUNA_APP_ID=your_app_id
# ADZUNA_APP_KEY=your_api_key
# ADZUNA_COUNTRY=us

# USAJobs - Official US federal government jobs (free, unlimited)
# Sign up at: https://developer.usajobs.gov/
# USAJOBS_API_KEY=your_api_key
# USAJOBS_EMAIL=your_email@example.com